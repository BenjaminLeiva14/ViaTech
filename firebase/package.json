{
  "name": "viatech-laboratorio",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "simulator": "node ../simulation/simulator.mjs",
    "emulators": "node scripts/emulator-cli.cjs emulators:start --project demo-viatech",
    "verify": "node scripts/emulator-cli.cjs emulators:exec --project demo-viatech --only auth,firestore \"npm test\""
  },
  "dependencies": {
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.34.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
